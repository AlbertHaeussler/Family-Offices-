# ── Green Street auth — pick ONE of the two ways ──
#
# WAY 1 (free, no API product): paste the bearer token the logged-in Green
# Street WEBSITE already uses. In your browser, logged into greenstreetnews.com:
#   F12 (DevTools) → "Network" tab → click a news article/list →
#   find a request to web-news-service.greenstreet.com →
#   open "Headers" → copy the value after "Authorization: Bearer " →
#   paste it below (without the word "Bearer"). Tokens expire after a while;
#   if the crawl stops with a 401, grab a fresh one and run again (it resumes).
GS_BEARER_TOKEN=

# WAY 2 (official API product): client credentials from
#   https://my.greenstreet.com/client-credentials  (needs API entitlement).
GS_CLIENT_ID=
GS_CLIENT_SECRET=

# Optional overrides (defaults shown):
# GS_OAUTH_URL=https://login.greenstreet.com/oauth/token
# GS_AUDIENCE=https://api.greenstreet.com
# GS_BASE_URL=https://web-news-service.greenstreet.com

# Extraction model (Schritt 2). Default is the cheap Haiku; switch to
# claude-sonnet-5 only if extraction quality on hard articles needs it.
# ANTHROPIC_MODEL=claude-haiku-4-5
