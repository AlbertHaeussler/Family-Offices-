# Green Street client credentials — generate at:
#   https://my.greenstreet.com/client-credentials
# (You need a Green Street account with API entitlement. Copy this file to
#  `.env` and fill in real values. `.env` is git-ignored — never commit it.)

GS_CLIENT_ID=
GS_CLIENT_SECRET=

# Optional overrides (defaults shown):
# GS_OAUTH_URL=https://login.greenstreet.com/oauth/token
# GS_AUDIENCE=https://api.greenstreet.com
# GS_BASE_URL=https://web-news-service.greenstreet.com

# Extraction model (Schritt 2). Default is the cheap Haiku; switch to
# claude-sonnet-5 only if extraction quality on hard articles needs it.
# ANTHROPIC_MODEL=claude-haiku-4-5
