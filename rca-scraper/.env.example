# Copy to .env and fill in only if you want non-interactive runs.
# For the normal (recommended) flow you log in by hand in the browser the tool
# opens, so you usually DO NOT need to put credentials here at all.

# Optional: pre-fill the login form during `rca-scrape capture`.
# Leave blank to type them yourself in the browser (more secure).
RCA_EMAIL=
RCA_PASSWORD=

# Optional overrides (defaults live in config/config.yaml)
# RCA_BASE_URL=https://app.rcanalytics.com
# RCA_LOG_LEVEL=INFO
